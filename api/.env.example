# Rails API local environment template. Copy to .env and fill secrets locally.
DATABASE_URL=
RAILS_MASTER_KEY=
RAILS_ENV=development

# Active Record Encryption
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Single-owner and worker authentication
APP_SHARED_SECRET=
SESSION_SECRET=
WORKER_SERVICE_TOKEN=

# OpenRouter LLM gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
# Nex defaults to high reasoning; keep short structured generation responsive.
OPENROUTER_REASONING_EFFORT=none
JOB_TRIAGE_AUTO_SCORE_DAILY_LIMIT=20

# Resend inbound email
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=

# Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Feature flags and optional infrastructure
LINKEDIN_EASY_APPLY_ENABLED=false
REDIS_URL=
