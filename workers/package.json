{
  "name": "waunder-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Waunder Playwright automation worker: fills supported ATS application forms from approved, structured payloads.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
